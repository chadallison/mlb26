mutate(roll_dist = rollapply(dist, width = 7, FUN = "sum", align = "right", partial = T)) |>
filter(date >= Sys.Date() - 90) |>
ggplot(aes(date, roll_dist)) +
geom_line(linewidth = 1.25, col = "springgreen4")
