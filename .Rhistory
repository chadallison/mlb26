library(tidyverse)
library(janitor)
library(patchwork)
library(googlesheets4)
library(kableExtra)
library(zoo)
theme_custom = function() {
ggplot2::theme_minimal() +
theme(
plot.background = element_rect(color = NA, fill = "#ece5d3"),
panel.background = element_rect(color = NA, fill = "#ece5d3"),
panel.grid.major = element_line(linewidth = 0.5, colour = "#DFDAD1"),
panel.grid.minor = element_line(linewidth = 0.5, colour = "#DFDAD1"),
plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5, size = 9, vjust = 2.5, face = "italic"),
plot.caption = element_text(face = "italic"),
axis.text = element_text(size = 8, color = "grey20"),
axis.title = element_text(size = 10, color = "grey20"),
legend.position = "bottom",
legend.text = element_text(size = 8, color = "grey20"),
legend.title = element_text(size = 10, color = "grey20"),
legend.key = element_rect(colour = "black", linetype = "solid", linewidth = 1.25),
legend.background = element_rect(color = "black", fill = "#ece5d3", linetype = "solid"),
axis.ticks = element_blank(),
axis.ticks.x = element_blank(),
axis.ticks.y = element_blank()
)
}
theme_set(theme_custom())
sheet_url = "https://docs.google.com/spreadsheets/d/1oBUbxvufTpkGjnDgfadvUeU9KMo7o71Iu0ykJwERzMc"
gs4_deauth()
df = read_sheet(sheet_url) |>
select(-run) |>
mutate(date = as_date(date))
format_run_cnt = function(run_cnt) {
cnt = format(run_cnt, big.mark = ",", scientific = F)
paste0(cnt, " runs")
}
format_distance = function(distance) {
dist = format(round(distance, 2), nsmall = 2, big.mark = ",")
paste0(dist, " mi")
}
format_time = function(minutes) {
total_seconds = round(minutes * 60)
days = total_seconds %/% 86400
rem = total_seconds %% 86400
hours = rem %/% 3600
rem = rem %% 3600
mins = rem %/% 60
secs = rem %% 60
if (days > 0) {
sprintf("%dd %dh %dm %ds", days, hours, mins, secs)
} else if (hours > 0) {
sprintf("%dh %dm %ds", hours, mins, secs)
} else {
sprintf("%dm %ds", mins, secs)
}
}
format_pace = function(minutes) {
total_seconds = round(minutes * 60)
mins = total_seconds %/% 60
secs = total_seconds %% 60
sprintf("%d:%02d min/mi", mins, secs)
}
format_date = function(dt) {
paste0(month(dt, label = T, abbr = T), " ", day(dt), ", ", year(dt))
}
total_run_cnt = format_run_cnt(nrow(df))
total_distance = format_distance(sum(df$distance))
total_time = format_time(sum(df$time))
total_pace = format_pace(sum(df$time) / sum(df$distance))
pw = df |>
filter(date > Sys.Date() - 7)
pw_runs = format_run_cnt(nrow(pw))
pw_distance = format_distance(sum(pw$distance))
pw_time = format_time(sum(pw$time))
pw_pace = format_pace(sum(pw$time) / sum(pw$distance))
pm = df |>
filter(date >= Sys.Date() - 30)
pm_runs = format_run_cnt(nrow(pm))
pm_distance = format_distance(sum(pm$distance))
pm_time = format_time(sum(pm$time))
pm_pace = format_pace(sum(pm$time) / sum(pm$distance))
pn = df |>
filter(date >= Sys.Date() - 90)
pn_runs = format_run_cnt(nrow(pn))
pn_distance = format_distance(sum(pn$distance))
pn_time = format_time(sum(pn$time))
pn_pace = format_pace(sum(pn$time) / sum(pn$distance))
py = df |>
filter(date >= Sys.Date() - 365)
py_runs = format_run_cnt(nrow(py))
py_distance = format_distance(sum(py$distance))
py_time = format_time(sum(py$time))
py_pace = format_pace(sum(py$time) / sum(py$distance))
ytd = df |>
filter(year(date) == year(Sys.Date()))
ytd_runs = format_run_cnt(nrow(ytd))
ytd_distance = format_distance(sum(ytd$distance))
ytd_time = format_time(sum(ytd$time))
ytd_pace = format_pace(sum(ytd$time) / sum(ytd$distance))
last_run = tail(df, 1)
output = paste0(
format_distance(last_run$distance),
" @ ",
format_pace(last_run$pace),
" on ",
format_date(last_run$date)
)
summary_tbl = tibble(
Period = c("All-Time", "Past Week", "Past Month", "Past 90 Days", "Past Year", "YTD"),
Runs = c(total_run_cnt, pw_runs, pm_runs, pn_runs, py_runs, ytd_runs),
Distance = c(total_distance, pw_distance, pm_distance, pn_distance, py_distance, ytd_distance),
Time = c(total_time, pw_time, pm_time, pn_time, py_time, ytd_time),
`Avg. Pace` = c(total_pace, pw_pace, pm_pace, pn_pace, py_pace, ytd_pace)
)
kable(summary_tbl, align = "c", format = "markdown")
shoe_agg_tbl = df |>
group_by(shoe) |>
summarise(runs = n(),
dist = sum(distance),
time = sum(time),
pace = sum(time) / sum(distance),
first_used = min(date),
last_used = max(date),
max_dist = max(distance)) |>
filter(runs > 1 & last_used >= Sys.Date() - 365) |>
arrange(desc(last_used)) |>
rowwise() |>
transmute(
Shoe = shoe,
Runs = format_run_cnt(runs),
Distance = format_distance(dist),
Time = format_time(time),
`Avg. Pace` = format_pace(pace),
`First Used` = format_date(first_used),
`Last Used` = format_date(last_used),
`Longest Run` = format_distance(max_dist)
) |>
ungroup()
kable(shoe_agg_tbl, align = "c", format = "markdown")
dim_yr_wk = tibble(date = seq.Date(from = min(df$date), to = max(df$date), by = 1)) |>
mutate(yr_wk = paste0(year(date), "-", sprintf("%02d", week(date))),
yr_wk = factor(yr_wk)) |>
group_by(yr_wk) |>
summarise(min_dt = min(date),
max_dt = max(date),
dt_range = paste0(min_dt, " - ", max_dt))
dim_yr_mth = tibble(date = seq.Date(from = min(df$date), to = max(df$date), by = 1)) |>
mutate(yr_mth = paste0(year(date), "-", sprintf("%02d", month(date))),
yr_mth = factor(yr_mth)) |>
group_by(yr_mth) |>
summarise(min_dt = min(date),
max_dt = max(date),
dt_range = paste0(min_dt, " - ", max_dt))
yr_mth_agg = df |>
mutate(yr_mth = paste0(year(date), "-", sprintf("%02d", month(date))),
yr_mth = factor(yr_mth)) |>
group_by(yr_mth) |>
summarise(dist = sum(distance),
time = sum(time))
dim_yr_mth |>
left_join(yr_mth_agg, by = "yr_mth") |>
filter(max_dt >= floor_date(Sys.Date() - 365, "month")) |>
mutate(dist = coalesce(dist, 0),
time = coalesce(time, 0),
pace = time / dist) |>
ggplot(aes(yr_mth, dist)) +
geom_col(fill = "springgreen4") +
geom_text(aes(label = dist), size = 3.5, vjust = -0.25) +
labs(x = NULL, y = "Distance (mi)",
title = "Distance by month, past year") +
scale_y_continuous(breaks = seq(0, 250, by = 10))
shoes_to_consider = df |>
filter(date >= Sys.Date() - 365) |>
count(shoe) |>
filter(n > 1) |>
pull(shoe)
df |>
filter(shoe %in% shoes_to_consider) |>
group_by(shoe) |>
summarise(avg_pace = mean(pace),
sd_pace  = sd(pace)) |>
mutate(lower = avg_pace - sd_pace,
upper = avg_pace + sd_pace) |>
ggplot(aes(x = reorder(shoe, avg_pace), y = avg_pace)) +
geom_pointrange(aes(col = shoe, ymin = lower, ymax = upper), linewidth = 7) +
coord_flip() +
labs(x = NULL,
y = "Pace",
title = "Average pace by shoe with ±1 SD range")
